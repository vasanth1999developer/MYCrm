<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.mycrm</groupId>
    <artifactId>mycrm-parent</artifactId>
    <version>1.0.0</version>

    <packaging>pom</packaging>

    <modules>
        <module>account-service</module>
        <module>authentication-service</module>
        <module>authorization-service</module>
        <module>company-service</module>
        <module>customer-service</module>
        <module>employee-service</module>
        <module>eureka-service</module>
        <module>gateway-service</module>
        <module>inventory-service</module>
        <module>lead-service</module>
        <module>opportunity-service</module>
        <module>product-service</module>
        <module>salesorder-service</module>
        <module>TaskManagement</module>
        <module>urlshortner</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <spring.boot.version>2.7.15</spring.boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>