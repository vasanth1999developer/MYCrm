<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.15</version>
        <relativePath/>
    </parent>

    <groupId>com.clinch</groupId>
    <artifactId>clinch-parent</artifactId>
    <version>1.0.0</version>
    <name>clinch-parent</name>
    <description>Clinch CRM: aggregator and shared Spring Boot 2.7 / Java 17 parent</description>

    <packaging>pom</packaging>

    <modules>
        <module>account-service</module>
        <module>authentication-service</module>
        <module>authorization-service</module>
        <module>company-service</module>
        <module>customer-service</module>
        <module>employee-service</module>
        <module>eureka-service</module>
        <module>gateway-service</module>
        <module>inventory-service</module>
        <module>lead-service</module>
        <module>opportunity-service</module>
        <module>product-service</module>
        <module>salesorder-service</module>
        <module>TaskManagement</module>
        <module>urlshortner</module>
    </modules>

    <!--
        Single source of Java level, plugin versions and Spring Boot dependency versions for
        every child module. Children must NOT hard-code maven-compiler-plugin source/target;
        java.version below is turned into release=17 by the Boot parent.
    -->
    <properties>
        <java.version>17</java.version>
    </properties>

</project>